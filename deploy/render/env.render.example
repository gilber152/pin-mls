# ==============================================================================
# Variables de entorno para Render (pin-mls-api) + Supabase (PostgreSQL 16)
# ==============================================================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# 1. Supabase -> Project Settings -> Database -> Connection string (URI)
# Usa el Session Pooler (puerto 5432) o Direct connection con ?sslmode=require
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# 2. Redis: inyectado automáticamente por render.yaml (o pega aquí tu URL de Upstash/Render)
# REDIS_URL=redis://...

# 3. Claves Ed25519 para JWT (generar con ./scripts/gen-prod-secrets.sh)
JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# 4. Secretos simétricos (32 bytes hex)
POW_SECRET_HEX=reemplazar_con_64_hex_chars
COOLDOWN_SECRET_HEX=reemplazar_con_64_hex_chars

# 5. Origen permitido del cliente Web desplegado en Render Static Site
CORS_ORIGIN=https://pin-mls-web.onrender.com
