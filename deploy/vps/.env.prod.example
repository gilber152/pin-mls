# ==============================================================================
# Configuración de Producción VPS - PIN-MLS (Bloque 4B)
# Copia este archivo a deploy/vps/.env.prod y rellena tus valores reales
# ==============================================================================

# 1. Dominio público apuntando por registro DNS A a la IP de tu VPS
APP_DOMAIN=chat.tudominio.com
CORS_ORIGIN=https://chat.tudominio.com

# 2. Credenciales internas PostgreSQL 16 y Redis 7
POSTGRES_DB=pin_mls
POSTGRES_USER=pin_user
POSTGRES_PASSWORD=cambia_esta_clave_postgres_segura
REDIS_PASSWORD=cambia_esta_clave_redis_segura

# 3. Dificultad PoW Argon2id (6 es ideal para respuesta rápida en móviles)
POW_DIFFICULTY_REGISTER=6

# 4. Claves Ed25519 para JWT (generar con ./scripts/gen-prod-secrets.sh)
JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# 5. Secretos simétricos (64 caracteres hexadecimales = 32 bytes)
POW_SECRET_HEX=reemplazar_con_64_hex_chars
COOLDOWN_SECRET_HEX=reemplazar_con_64_hex_chars

POW_HMAC_SECRET_HEX=773ee8099a93da07b63a962e38e78ebdcf2f1989537c76927883046e23ccc431
COOLDOWN_PEPPER_HEX=5e8883899ebf9b6164e0ae96fdcfd1bc32713c87326779b5bafec8904323bb26
ALLOWED_WEB_ORIGINS=https://pin-mls-web.onrender.com,http://localhost:5173,http://127.0.0.1:5173