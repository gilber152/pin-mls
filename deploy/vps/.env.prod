# ==============================================================================
# Configuración de Producción VPS - PIN-MLS (Bloque 4B)
# Copia este archivo a deploy/vps/.env.prod y rellena tus valores reales
# ==============================================================================

# 1. Dominio público apuntando por registro DNS A a la IP de tu VPS
APP_DOMAIN=localhost
CORS_ORIGIN=https://pin-mls-web.onrender.com

# 2. Credenciales internas PostgreSQL 16 y Redis 7
POSTGRES_DB=pin_mls
POSTGRES_USER=pin_user
POSTGRES_PASSWORD=36d03076afca555c2952d6be53f5d419
REDIS_PASSWORD=0780d04f32364de8dd33220b7987d91d

# 3. Dificultad PoW Argon2id (6 es ideal para respuesta rápida en móviles)
POW_DIFFICULTY_REGISTER=6

# 4. Claves Ed25519 para JWT (generar con ./scripts/gen-prod-secrets.sh)
JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIBh3PG1A5PCWGq54PfzWWYesh5SZaMlKcFgNfIcEYfQ2\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAEoDV2qd+F0+EboOeUTxdO3+27fzg2TmdsyJyuFt3AQo=\n-----END PUBLIC KEY-----\n"

# 5. Secretos simétricos (64 caracteres hexadecimales = 32 bytes)
